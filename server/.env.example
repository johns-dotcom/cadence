# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/cadence
JWT_SECRET=change-me-to-a-long-random-string-in-production
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Auth ────────────────────────────────────────────────────────────────
# There is NO public signup. Workspaces are provisioned by a platform admin.
# Google SSO (optional). Leave blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# ── Cloudflare R2 (S3-compatible object storage) ─────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── First platform admin (bootstrap) ─────────────────────────────────────
# REQUIRED for a fresh deploy: with no public signup, this is how the very
# first account is created. On first boot (no labels yet), if
# SEED_ADMIN_PASSWORD is set, the server creates this label + an owner who is
# the platform admin. After that, provision new label workspaces in-app.
SEED_LABEL_NAME=Your Label
SEED_ADMIN_NAME=Your Name
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=

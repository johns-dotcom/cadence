# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/cadence
JWT_SECRET=change-me-to-a-long-random-string-in-production
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Auth ────────────────────────────────────────────────────────────────
# Allow public self-serve signup (creates a new label + first Superadmin).
# Set to "false" to lock signups (e.g. invite-only deployments).
ALLOW_SIGNUP=true
# Google SSO (optional). Leave blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# ── Cloudflare R2 (S3-compatible object storage) ─────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Demo seed (optional) ─────────────────────────────────────────────────
# If set, `npm run seed` creates a demo label with this owner.
SEED_LABEL_NAME=Demo Label
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

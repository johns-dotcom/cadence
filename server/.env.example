# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/cadence
JWT_SECRET=change-me-to-a-long-random-string-in-production
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Auth ────────────────────────────────────────────────────────────────
# There is NO public signup. Workspaces are provisioned by a platform admin.
# Google SSO (optional). Leave blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# ── Transactional email (member invites) ────────────────────────────────
# Sender shown on invite emails. With Resend/SendGrid the domain must be
# verified; with SMTP the mailbox sends it directly.
EMAIL_FROM=Cadence <john@deanst.co>
# Pick ONE delivery driver (checked in this order). If none is set, invites
# still work — the admin just gets a copyable link to share manually.
RESEND_API_KEY=
SENDGRID_API_KEY=
# …or SMTP (e.g. Gmail/Workspace with an app password):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── Integrations (all optional; features degrade gracefully if unset) ────
# Claude AI — invoice/W9/proof parsing, discrepancy + marketing OCR (shared key).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8   # override (e.g. claude-sonnet-4-6 for lower cost)
# Spotify — release artwork + artist stats sync (shared key, public data).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# FX rates use frankfurter.app — no key required.

# ── Cloudflare R2 (S3-compatible object storage) ─────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── First platform admin (bootstrap) ─────────────────────────────────────
# REQUIRED for a fresh deploy: with no public signup, this is how the very
# first account is created. On first boot (no labels yet), if
# SEED_ADMIN_PASSWORD is set, the server creates this label + an owner who is
# the platform admin. After that, provision new label workspaces in-app.
SEED_LABEL_NAME=Your Label
SEED_ADMIN_NAME=John Skead
SEED_ADMIN_EMAIL=john@deanst.co
SEED_ADMIN_PASSWORD=

# API base URL. In dev, Vite proxies /api → http://localhost:3001 (see
# vite.config.js), so you can leave this unset. In production the client is
# served same-origin by Express and falls back to /api automatically.
# VITE_API_URL=http://localhost:3001/api

# Google SSO (optional). Must match GOOGLE_CLIENT_ID on the server.
VITE_GOOGLE_CLIENT_ID=
